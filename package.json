{
  "name": "web-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript contracts/vendor/inventory-api.yaml -o src/api/generated/inventory.ts && openapi-typescript contracts/vendor/orders-api.yaml -o src/api/generated/orders.ts"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "openapi-typescript": "7.5.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
